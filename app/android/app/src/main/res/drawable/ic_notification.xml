<?xml version="1.0" encoding="utf-8"?>
<!--
  El icono de los avisos en la barra de estado (Buscaminas / Minesweeper).

  Android IGNORA los colores de este dibujo: se queda con su SILUETA y la pinta
  de blanco (#FFFFFFFF), tintándola con `default_notification_color`.
  Silueta de la mina naval (8 puntas + anillo central con núcleo) a 24 dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Espigas verticales y horizontales -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M10.9,2 h2.2 v20 h-2.2 z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M2,10.9 h20 v2.2 h-20 z" />
    <!-- Espigas diagonales (45° y 135°) -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M4.15,5.71 L5.71,4.15 L19.85,18.29 L18.29,19.85 Z" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M18.29,4.15 L19.85,5.71 L5.71,19.85 L4.15,18.29 Z" />
    <!-- Esfera central con anillo interior hueco (evenOdd) y punto central -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,5.6 A6.4,6.4 0 1,0 12,18.4 A6.4,6.4 0 1,0 12,5.6 Z M12,8.6 A3.4,3.4 0 1,0 12,15.4 A3.4,3.4 0 1,0 12,8.6 Z M12,10.4 A1.6,1.6 0 1,0 12,13.6 A1.6,1.6 0 1,0 12,10.4 Z" />
</vector>
